# load these values into your shell before pnpm bench:compare

# Hosted Supermemory API. Create a key at https://console.supermemory.ai.
BENCH_SUPERMEMORY_URL=https://api.supermemory.ai
BENCH_SUPERMEMORY_API_KEY=
# SUPERMEMORY_API_KEY=  # accepted fallback

# Hosted Mem0 Platform API. Create a key at https://app.mem0.ai.
BENCH_MEM0_URL=https://api.mem0.ai
BENCH_MEM0_API_KEY=
# MEM0_API_KEY=  # accepted fallback

# Hosted Zep Cloud graph API. Create a key at https://app.getzep.com.
# The provider keeps the CLI name "graphiti" for compatibility.
BENCH_GRAPHITI_URL=https://api.getzep.com/api/v2
BENCH_GRAPHITI_API_KEY=
# ZEP_API_KEY=  # accepted fallback

BENCH_COGNEE_URL=http://127.0.0.1:8002
BENCH_COGNEE_API_KEY=

# optional for every provider
# BENCH_<PROVIDER>_TIMEOUT_MS=120000
# Mem0 Platform and Zep Cloud use profile=cloud by default. Explicit local
# compatibility profiles require separately running upstream infrastructure:
# BENCH_MEM0_PROFILE=oss
# BENCH_MEM0_URL=http://127.0.0.1:8888
# BENCH_GRAPHITI_PROFILE=local
# BENCH_GRAPHITI_URL=http://127.0.0.1:8001
# BENCH_<PROVIDER>_ROUTES={"health":"/health","search":"/search"}

# optional AI answerer and judge
# use with --answerer=<provider>:<model> --judge=<provider>:<model>
# required by bench:full, bench:ci:full, and bench:compare; use distinct models
# BENCH_OFFICIAL_ANSWERER=codex:gpt-5.4-mini
# BENCH_OFFICIAL_JUDGE=codex:gpt-5.6-terra

# Gemini free-tier embedding batches count each input; use a safety margin below 100/minute.
# OPENMEMORY_GEMINI_INPUTS_PER_MINUTE=90
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# OpenAI-compatible endpoints use the OpenAI key/base URL variables
# BENCH_OPENAI_API_KEY=
# BENCH_OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# BENCH_LLM_TIMEOUT_MS=120000
# BENCH_LLM_MAX_RETRIES=3
# BENCH_LLM_MAX_TOKENS=1000
# BENCH_LLM_TEMPERATURE=0

# Ollama HTTP API (no API key)
# OLLAMA_HOST=http://127.0.0.1:11434

# Local app executable overrides. Codex is auto-discovered in the standard
# Windows app location. Official runs use Codex for both roles.
# BENCH_CODEX_COMMAND=C:\Users\you\AppData\Local\OpenAI\Codex\bin\codex.exe
