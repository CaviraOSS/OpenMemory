{
    "name": "longmemory-vscode",
    "displayName": "LongMemory",
    "description": "Native Hydrograph memory workflows for VS Code",
    "version": "0.2.0",
    "publisher": "CaviraOSS",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/CaviraOSS/LongMemory"
    },
    "engines": {
        "vscode": "^1.96.0"
    },
    "extensionKind": [
        "workspace"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": false,
            "description": "LongMemory executes the configured local CLI and writes workspace-scoped memory. Trust the workspace before enabling it."
        }
    },
    "categories": [
        "AI",
        "Other"
    ],
    "keywords": [
        "memory",
        "ai",
        "agents",
        "mcp",
        "hydrograph"
    ],
    "main": "./dist/extension.js",
    "activationEvents": [
        "onStartupFinished"
    ],
    "files": [
        "dist",
        "media",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "longmemory",
                    "title": "LongMemory",
                    "icon": "media/longmemory.svg"
                }
            ]
        },
        "views": {
            "longmemory": [
                {
                    "id": "longmemory.memories",
                    "name": "Memories"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "longmemory.memories",
                "contents": "No memories are loaded for this workspace.\n[Initialize LongMemory](command:longmemory.initialize)\n[Remember a quick note](command:longmemory.quickNote)"
            }
        ],
        "commands": [
            {
                "command": "longmemory.refresh",
                "title": "Refresh Memories",
                "category": "LongMemory",
                "icon": "$(refresh)"
            },
            {
                "command": "longmemory.initialize",
                "title": "Initialize Workspace Memory",
                "category": "LongMemory",
                "icon": "$(database)"
            },
            {
                "command": "longmemory.rememberSelection",
                "title": "Remember Selection",
                "category": "LongMemory",
                "icon": "$(bookmark)"
            },
            {
                "command": "longmemory.quickNote",
                "title": "Remember a Quick Note",
                "category": "LongMemory",
                "icon": "$(edit)"
            },
            {
                "command": "longmemory.recall",
                "title": "Recall Context",
                "category": "LongMemory",
                "icon": "$(search)"
            },
            {
                "command": "longmemory.projectContext",
                "title": "Build Project Context",
                "category": "LongMemory",
                "icon": "$(repo)"
            },
            {
                "command": "longmemory.explain",
                "title": "Explain Memory",
                "category": "LongMemory",
                "icon": "$(inspect)"
            },
            {
                "command": "longmemory.reinforce",
                "title": "Reinforce Memory",
                "category": "LongMemory",
                "icon": "$(arrow-up)"
            },
            {
                "command": "longmemory.runDecay",
                "title": "Run Decay Maintenance",
                "category": "LongMemory",
                "icon": "$(history)"
            },
            {
                "command": "longmemory.startAgentSession",
                "title": "Start AI Change Session",
                "category": "LongMemory",
                "icon": "$(record)"
            },
            {
                "command": "longmemory.stopAgentSession",
                "title": "Stop AI Change Session",
                "category": "LongMemory",
                "icon": "$(debug-stop)"
            },
            {
                "command": "longmemory.reviewAgentChanges",
                "title": "Review AI Change Candidates",
                "category": "LongMemory",
                "icon": "$(diff)"
            },
            {
                "command": "longmemory.discardAgentChanges",
                "title": "Discard Pending AI Change Candidates",
                "category": "LongMemory",
                "icon": "$(trash)"
            },
            {
                "command": "longmemory.importSessions",
                "title": "Import Coding Sessions",
                "category": "LongMemory",
                "icon": "$(repo-pull)"
            },
            {
                "command": "longmemory.openSettings",
                "title": "Open Settings",
                "category": "LongMemory",
                "icon": "$(gear)"
            },
            {
                "command": "longmemory.showActions",
                "title": "Manage LongMemory",
                "category": "LongMemory"
            },
            {
                "command": "longmemory.openOutput",
                "title": "Open Output",
                "category": "LongMemory"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "longmemory.importSessions",
                    "when": "view == longmemory.memories",
                    "group": "navigation@1"
                },
                {
                    "command": "longmemory.quickNote",
                    "when": "view == longmemory.memories",
                    "group": "navigation@2"
                },
                {
                    "command": "longmemory.refresh",
                    "when": "view == longmemory.memories",
                    "group": "navigation@3"
                }
            ],
            "view/item/context": [
                {
                    "command": "longmemory.explain",
                    "when": "view == longmemory.memories && viewItem == longmemory.memory",
                    "group": "inline@1"
                },
                {
                    "command": "longmemory.reinforce",
                    "when": "view == longmemory.memories && viewItem == longmemory.memory",
                    "group": "inline@2"
                }
            ],
            "editor/context": [
                {
                    "command": "longmemory.rememberSelection",
                    "when": "editorHasSelection",
                    "group": "navigation@20"
                }
            ]
        },
        "configuration": {
            "title": "LongMemory",
            "properties": {
                "longmemory.cliPath": {
                    "type": "string",
                    "default": "longmemory",
                    "scope": "resource",
                    "restricted": true,
                    "description": "LongMemory CLI executable or JavaScript entry path."
                },
                "longmemory.database": {
                    "type": "string",
                    "default": ".longmemory/project.db",
                    "scope": "resource",
                    "description": "Workspace-relative or absolute SQLite database path."
                },
                "longmemory.project": {
                    "type": "string",
                    "default": "current",
                    "scope": "resource",
                    "description": "Project ID used to scope memory operations."
                },
                "longmemory.user": {
                    "type": "string",
                    "default": "default",
                    "scope": "resource",
                    "description": "User ID supplied to LongMemory recall and ingest gates."
                },
                "longmemory.agentId": {
                    "type": "string",
                    "default": "",
                    "scope": "resource",
                    "description": "Agent identity used to resolve governed memory asset bindings for project context."
                },
                "longmemory.framework": {
                    "type": "string",
                    "default": "vscode",
                    "scope": "resource",
                    "description": "Agent framework identity used to resolve portable memory asset bindings."
                },
                "longmemory.recallMode": {
                    "type": "string",
                    "enum": [
                        "strict",
                        "associative",
                        "historical",
                        "world_grounded"
                    ],
                    "default": "associative",
                    "scope": "resource",
                    "description": "Default recall mode for the Recall Context command."
                },
                "longmemory.listLimit": {
                    "type": "number",
                    "default": 50,
                    "minimum": 1,
                    "maximum": 200,
                    "scope": "resource",
                    "description": "Maximum memories shown in the activity-bar view."
                },
                "longmemory.autoRefresh": {
                    "type": "boolean",
                    "default": true,
                    "description": "Refresh the memory view after explicit LongMemory writes."
                },
                "longmemory.agentChanges.heuristicDetection": {
                    "type": "boolean",
                    "default": false,
                    "scope": "resource",
                    "description": "Queue low-confidence editor change candidates when a known AI coding extension is installed. Off by default; candidates are never auto-recorded."
                },
                "longmemory.agentChanges.autoRecordExplicit": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "description": "Record explicitly started AI change sessions when they are stopped."
                },
                "longmemory.agentChanges.quietPeriodMs": {
                    "type": "number",
                    "default": 3000,
                    "minimum": 500,
                    "maximum": 30000,
                    "scope": "resource",
                    "description": "Quiet period used to coalesce heuristic document changes."
                },
                "longmemory.agentChanges.maxPatchBytes": {
                    "type": "number",
                    "default": 65536,
                    "minimum": 4096,
                    "maximum": 524288,
                    "scope": "resource",
                    "description": "Maximum redacted patch bytes stored for one AI change set."
                },
                "longmemory.agentChanges.maxDocumentBytes": {
                    "type": "number",
                    "default": 1000000,
                    "minimum": 16384,
                    "maximum": 10000000,
                    "scope": "resource",
                    "description": "Maximum text document size eligible for change tracking."
                },
                "longmemory.agentChanges.maxSessionSnapshotBytes": {
                    "type": "number",
                    "default": 33554432,
                    "minimum": 1048576,
                    "maximum": 268435456,
                    "scope": "resource",
                    "description": "Maximum in-memory baseline bytes for an explicit AI change session. Baselines are discarded when the session stops and are never persisted."
                }
            }
        }
    },
    "scripts": {
        "check": "tsc --noEmit -p tsconfig.json",
        "compile": "node esbuild.mjs",
        "watch": "node esbuild.mjs --watch",
        "package": "pnpm compile && vsce package --no-dependencies",
        "vscode:prepublish": "pnpm compile"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "@types/vscode": "^1.96.0",
        "@vscode/vsce": "^3.2.1",
        "esbuild": "^0.24.2",
        "typescript": "^5.9.3"
    }
}