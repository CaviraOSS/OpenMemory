{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "LongMemory: build extension",
      "type": "shell",
      "command": "pnpm compile",
      "problemMatcher": "$tsc",
      "group": "build"
    },
    {
      "label": "LongMemory: watch extension",
      "type": "shell",
      "command": "pnpm watch",
      "isBackground": true,
      "problemMatcher": "$tsc-watch"
    }
  ]
}
