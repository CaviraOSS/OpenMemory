{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run LongMemory Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "LongMemory: build extension"
    }
  ]
}
