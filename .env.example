#  file  : .env.example
#  usage : supports LongMemory .env

# LongMemory Hydrograph environment configuration

# Server and persistence
LONGMEMORY_HOST=127.0.0.1
LONGMEMORY_PORT=7331
LONGMEMORY_DB_PATH=./longmemory.db
LONGMEMORY_API_KEY=
LONGMEMORY_MCP_HTTP=false

# Request controls
LONGMEMORY_MAX_PAYLOAD_SIZE=1048576
LONGMEMORY_MAX_ACTIVE_REQUESTS=64
LONGMEMORY_RATE_LIMIT_ENABLED=false
LONGMEMORY_RATE_LIMIT_WINDOW_MS=60000
LONGMEMORY_RATE_LIMIT_MAX_REQUESTS=100
LONGMEMORY_ALLOWED_ORIGINS=http://127.0.0.1:3000
LONGMEMORY_LOG_AUTH=false

# Local runtime telemetry only. No outbound telemetry is sent.
LONGMEMORY_TELEMETRY=true

# Memory behavior
LONGMEMORY_MAX_CONTEXT_TOKENS=2048
LONGMEMORY_STRICT_CONFIDENCE_THRESHOLD=0.5
LONGMEMORY_GROUNDING_THRESHOLD=0.6
LONGMEMORY_ENABLE_COLD_LOG=false
LONGMEMORY_ENABLE_CONSOLIDATION=false
LONGMEMORY_DEFAULT_LANGUAGE=en
LONGMEMORY_OUTPUT_LANGUAGE=
LONGMEMORY_PRESERVE_ORIGINAL_TEXT=true
LONGMEMORY_ENABLE_TRANSLATION=false
LONGMEMORY_ENABLE_TRANSLITERATION=true

# Embeddings
# Providers: openai, gemini, aws, ollama, local, siray, synthetic
# Tiers:
#   hybrid/fast = deterministic local embeddings plus existing lexical ranking
#   smart       = 35% deterministic + 65% selected semantic provider
#   deep        = selected semantic provider directly
LONGMEMORY_EMBEDDING_PROVIDER=synthetic
LONGMEMORY_EMBEDDING_TIER=hybrid
LONGMEMORY_EMBEDDING_FALLBACK=synthetic
LONGMEMORY_EMBEDDING_DIMENSION=256
LONGMEMORY_EMBEDDING_TIMEOUT_MS=30000
LONGMEMORY_EMBEDDING_MAX_RETRIES=2
LONGMEMORY_EMBEDDING_RETRY_BASE_MS=250

# OpenAI or OpenAI-compatible provider
OPENAI_API_KEY=
LONGMEMORY_OPENAI_BASE_URL=https://api.openai.com/v1
LONGMEMORY_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini
GEMINI_API_KEY=
LONGMEMORY_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LONGMEMORY_GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Ollama
LONGMEMORY_OLLAMA_URL=http://127.0.0.1:11434
LONGMEMORY_OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# AWS Bedrock Titan. The AWS SDK uses its normal credential provider chain.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
LONGMEMORY_AWS_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# Local HTTP embedding service. Response may be OpenAI-style, {embedding}, or {vector}.
LONGMEMORY_LOCAL_EMBEDDING_URL=http://127.0.0.1:8081/embeddings
LONGMEMORY_LOCAL_EMBEDDING_MODEL=local-model

# Siray OpenAI-compatible embeddings
SIRAY_API_TOKEN=
LONGMEMORY_SIRAY_BASE_URL=https://api.siray.ai/v1
LONGMEMORY_SIRAY_EMBEDDING_MODEL=text-embedding-3-small

# Audio/video transcription
# OPENAI_API_KEY is reused. Video also requires ffmpeg on PATH.
FFMPEG_PATH=ffmpeg

# Optional source credentials. Use read-only, least-privilege tokens.
GITHUB_TOKEN=
GITLAB_TOKEN=
BITBUCKET_TOKEN=
AZURE_DEVOPS_TOKEN=
GOOGLE_ACCESS_TOKEN=
MICROSOFT_GRAPH_TOKEN=
NOTION_API_KEY=
SLACK_BOT_TOKEN=
LINEAR_API_KEY=

# Dashboard server-side proxy
LONGMEMORY_API_URL=http://127.0.0.1:7331

# Supported legacy aliases from the pre-Hydrograph environment:
# OM_PORT, OM_API_KEY, OM_DB_PATH, OM_MAX_PAYLOAD_SIZE, OM_MAX_ACTIVE,
# OM_RATE_LIMIT_ENABLED, OM_RATE_LIMIT_WINDOW_MS, OM_RATE_LIMIT_MAX_REQUESTS,
# OM_LOG_AUTH, OM_TELEMETRY, OM_IDE_ALLOWED_ORIGINS, OM_AUTO_REFLECT,
# OM_EMBEDDINGS, OM_EMBEDDING_FALLBACK, OM_TIER, OM_VEC_DIM,
# OM_EMBED_TIMEOUT_MS, OM_OPENAI_API_KEY, OM_OPENAI_BASE_URL,
# OM_OPENAI_MODEL, OM_GEMINI_API_KEY, OM_GEMINI_BASE_URL, OM_GEMINI_MODEL,
# OM_OLLAMA_URL, OM_OLLAMA_MODEL, OM_LOCAL_MODEL_URL, OM_LOCAL_MODEL_PATH,
# OM_SIRAY_API_TOKEN, OM_SIRAY_BASE_URL, OM_SIRAY_MODEL.
#
# Intentionally superseded HSG knobs:
# - OM_DECAY_*: Hydrograph computes time-derived freshness/decay during ranking.
# - OM_DECAY_REINFORCE_ON_QUERY: recall is deliberately read-only.
# - OM_EMBED_MODE/OM_ADV_EMBED_PARALLEL/OM_EMBED_DELAY_MS: Hydrograph embeds one
#   immutable event or query at a time; provider retries/fallback are bounded.
# - OM_MIN_SCORE: strict confidence and mode-specific gates define admission.
# - OM_USE_SUMMARY_ONLY: exact original text is immutable source truth.
# - OM_SEG_SIZE/OM_CACHE_SEGMENTS: bounded sketches and SQLite indexes replace segments.
# - OM_COMPRESSION_*: mergeable sketches are always available; consolidation is explicit.
# - OM_REFLECT_INTERVAL/OM_REFLECT_MIN_MEMORIES: consolidation runs transactionally
#   during ingest when LONGMEMORY_ENABLE_CONSOLIDATION or OM_AUTO_REFLECT is enabled.
# - OM_MODE/OM_LG_*: project memory and MCP provide agent orchestration.
# - OM_METADATA_BACKEND/OM_VECTOR_BACKEND: current durable backend is SQLite.
